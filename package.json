  "type": "module",
  "license": "MIT",
  "author": "BotArmor AI (Rhone IA)",
  "homepage": "https://github.com/sidorenkav-collab/paperclip-plugin-botarmor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sidorenkav-collab/paperclip-plugin-botarmor.git"
  },
  "bugs": {
    "url": "https://github.com/sidorenkav-collab/paperclip-plugin-botarmor/issues"
  },
  "keywords": [
    "paperclip",
    "paperclip-plugin",
    "ai-agents",
    "red-team",
    "security",
    "botarmor"
